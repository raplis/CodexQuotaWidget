  <Window x:Class="CodexQuotaWidget.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 额度" Width="300" Height="370" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" WindowStartupLocation="Manual" Loaded="OnLoaded" SourceInitialized="OnSourceInitialized" Closing="OnClosing">
  <Window.ContextMenu><ContextMenu><MenuItem Header="刷新额度" Click="Refresh_Click"/><MenuItem Header="置顶" IsCheckable="True" IsChecked="True" Click="Topmost_Click"/><Separator/><MenuItem Header="退出" Click="ContextExit_Click"/></ContextMenu></Window.ContextMenu>
  <Border Background="{StaticResource Panel}" CornerRadius="18" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" MouseLeftButtonDown="WindowDrag">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <StackPanel Orientation="Horizontal"><Border Width="32" Height="32" Background="{StaticResource Green}" CornerRadius="10" Margin="0,0,11,0"><TextBlock Text="✦" Foreground="#172015" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="CODEX" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="Bold"/><TextBlock Text="用量小浮窗" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CollapseButton" Click="Collapse_Click" Style="{StaticResource IconButton}" ToolTip="折叠"><TextBlock x:Name="CollapseGlyph" Text="⌃" FontSize="20" Margin="0,4,0,0"/></Button><Button x:Name="RefreshButton" Content="↻" Click="Refresh_Click" Style="{StaticResource IconButton}" ToolTip="刷新"/><Button Content="⚙" Click="Settings_Click" Style="{StaticResource IconButton}" ToolTip="设置"/><Button Content="×" Click="Exit_Click" Style="{StaticResource IconButton}" ToolTip="关闭"/></StackPanel>
      </Grid>
      <StackPanel x:Name="QuotaContent" Grid.Row="1" Margin="0,18,0,12">
        <TextBlock x:Name="QuotaTitle" Text="使用额度" Foreground="{StaticResource Muted}" FontSize="12"/>
        <StackPanel x:Name="FiveHourSection" Visibility="Visible">
          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="5 小时窗口" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="FiveHourText" Grid.Column="1" Foreground="{StaticResource Green}" FontSize="15" FontWeight="Bold"/></Grid>
          <ProgressBar x:Name="FiveHourBar" Margin="0,8,0,16" Maximum="100" Style="{StaticResource GreenProgress}"/>
        </StackPanel>
        <StackPanel x:Name="WeekSection">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="1 周窗口" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="WeekText" Grid.Column="1" Foreground="{StaticResource Amber}" FontSize="15" FontWeight="Bold"/></Grid>
          <ProgressBar x:Name="WeekBar" Margin="0,8,0,0" Maximum="100" Style="{StaticResource AmberProgress}"/>
        </StackPanel>
        <StackPanel x:Name="LunaSection" Visibility="Collapsed">
          <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Luna 储备" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="LunaText" Grid.Column="1" Foreground="{StaticResource Green}" FontSize="15" FontWeight="Bold"/></Grid>
          <ProgressBar x:Name="LunaBar" Margin="0,8,0,0" Maximum="100" Style="{StaticResource GreenProgress}"/>
        </StackPanel>
      </StackPanel>
      <Border x:Name="FooterBorder" Grid.Row="2" Background="{StaticResource PanelSoft}" CornerRadius="10" Padding="10,8"><Grid><StackPanel><TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="UpdatedText" Foreground="#777C74" FontSize="10" Margin="0,3,0,0"/><TextBlock x:Name="ResetText" Foreground="#777C74" FontSize="10" Margin="0,2,0,0"/><TextBlock x:Name="CreditExpiryText" Foreground="#777C74" FontSize="10" Margin="0,2,0,0"/></StackPanel><Ellipse x:Name="StatusDot" Grid.Column="1" Width="7" Height="7" Fill="{StaticResource Amber}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
      <Border x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="2" Background="#F21A1D1C" CornerRadius="14" Padding="16" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/></ScrollViewer.Resources>
          <StackPanel>
            <Grid><TextBlock Text="浮窗设置" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold"/><Button Content="×" Click="Settings_Click" Style="{StaticResource IconButton}" HorizontalAlignment="Right"/></Grid>
            <TextBlock Text="透明度" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,15,0,4"/><Slider x:Name="OpacitySlider" Minimum="0.45" Maximum="1" Value="0.92" ValueChanged="Opacity_Changed"/>
            <TextBlock Text="字体大小" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,13,0,4"/><Slider x:Name="FontSizeSlider" Minimum="12" Maximum="18" Value="15" ValueChanged="FontSize_Changed"/>
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="主题颜色" Foreground="{StaticResource Ink}"/><ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="90" SelectedIndex="0" SelectionChanged="Theme_Changed"><ComboBoxItem Content="薄荷绿" Tag="mint"/><ComboBoxItem Content="冰蓝" Tag="blue"/><ComboBoxItem Content="紫罗兰" Tag="violet"/><ComboBoxItem Content="珊瑚橙" Tag="coral"/></ComboBox></Grid>
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="自动更新" Foreground="{StaticResource Ink}"/><ComboBox x:Name="IntervalCombo" Grid.Column="1" Width="90" SelectedIndex="0" SelectionChanged="Interval_Changed"><ComboBoxItem Content="30 秒" Tag="30"/><ComboBoxItem Content="60 秒" Tag="60"/><ComboBoxItem Content="关闭" Tag="0"/></ComboBox></Grid>
            <CheckBox x:Name="TopmostCheck" Content="始终最前" IsChecked="True" Checked="TopmostCheck_Click" Unchecked="TopmostCheck_Click" Foreground="{StaticResource Ink}" Margin="0,12,0,0"/>
            <CheckBox x:Name="StartMinimizedCheck" Content="启动时最小化到托盘" Foreground="{StaticResource Ink}" Margin="0,8,0,0" Checked="StartMinimized_Click" Unchecked="StartMinimized_Click"/>
            <CheckBox x:Name="StartWithWindowsCheck" Content="开机自动启动" Foreground="{StaticResource Ink}" Margin="0,8,0,0" Checked="StartWithWindows_Click" Unchecked="StartWithWindows_Click"/>
            <TextBlock Text="快捷键" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,15,0,4"/>
            <Button x:Name="HotkeyCapture" Content="Ctrl + Alt + C" Click="HotkeyCapture_Click" KeyDown="HotkeyCapture_KeyDown" Style="{StaticResource CaptureButton}"/>
            <TextBlock Text="点击上方按钮后，直接按下你想要的组合键" Foreground="#777C74" FontSize="10" Margin="0,5,0,14"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Border>
</Window>
